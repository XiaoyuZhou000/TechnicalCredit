class Circle implements Shape {
    private final int radius;

    Circle(int radius) {
        this.radius = radius;
    }

    public Circle clone() {
        return new Circle(this.radius);
    }

    public void draw() {
        System.out.println("Circle r=" + radius);
    }
}",
}
